# Copie para .env (NÃO versione o .env) para rodar localmente.
# No GitHub Actions, estes valores vêm dos Secrets do repositório.

# --- E-mail (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-app-de-16-digitos
EMAIL_FROM=seu-email@gmail.com
EMAIL_TO=drstirma@gmail.com

# --- IA (opcional; só se anthropic.enabled = true) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- PubMed (opcional; aumenta o rate limit do NCBI) ---
NCBI_API_KEY=
